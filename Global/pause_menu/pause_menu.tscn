[node name="RichTextLabel" type="RichTextLabel" parent="pause_menu/Status_effect_guide" unique_id=2000319812]
offset_left = -2209.0
offset_top = 536.0
offset_right = -1187.0
offset_bottom = 9675.0
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 60
theme_override_font_sizes/bold_font_size = 80
theme_override_font_sizes/bold_italics_font_size = 60
theme_override_font_sizes/italics_font_size = 40
bbcode_enabled = true
text = "[b]List of some status effect stuff and more stuff.[/b]

[font_size=40]Note: X will be used to represent stacks amount.

Note: Different status types
Single tick: Does action and loses a stack
Multi tick: Does action, loses mutliple stacks
Passive tick: Constantly does action, loses stacks(s) after time reached
Proc type: Reaches amount of tick, does action
Applied type: time is reset when repplied
[/font_size]

[b][color=orange]- Fire -[/color]
[i]Single tick type[/i][/b]
[left]Damage: X/2 damage
Max stacks: 50
Ticks per second: 4
Defense Penetration: 10
[/left]

[b][color=dark_red]- Bleed -[/color]
[i]Single tick type[/i][/b]
[left]Damage: 1% of max health
Max stacks: 10
Ticks per second: 2
Defense Penetration: 1000
[/left]

[b][color=black]- Death mark -[/color]
[i]Proc + Applied type[/i][/b]
[left]Damage: 20% of max health
Max stacks: 1000
Duration: 5s
Defense Penetration: 1000
[/left]

[b][color=yellow]- Shock -[/color]
[i]Mutli tick type[/i][/b]
[left]Actions: allows X% of stun time to be added.
Max stacks: 100
Ticks per second: 6
Stacks loss per tick: X/10
[/left]

[b][color=purple]- Venom -[/color]
[i]Single tick type[/i][/b]
[left]Damage: 5
Max stacks: 30
Ticks per second: 3
Defense Penetration: 25
[/left]

[b][color=dim_gray]- Defensive Stance -[/color]
[i]Passive Tick Type[/i][/b]
[left]Action: Gives 10(X) defense
Duration: NA
[/left]

[b][color=red]- Berserk -[/color]
[i]Passive Tick Type[/i][/b]
[left]Action: +10 str, +15 agi, +100% stamina regeneration
Duration: NA
[/left]

[b][color=gray]- Needle Stacks -[/color]
[i]Passive Tick + Applied Type[/i][/b]
[left]Action: Consumed when skills 2, 4, and 5 of the needle class are used. 
Duration: 100.0s
[/left]

[b][color=dark_slate_gray]- River Styx -[/color]
[i]Passive Tick Type[/i][/b]
[left]Action: Gives 4hp/s and causes soul explosions frequently. Soul explosions have a 10% chance to be super powered.
Damage: 25% of power stat
Duration: NA
[/left]

[b][color=sky_blue]- Retribution -[/color]
[i]Passive Tick + Applied Type[/i][/b]
[left]Action: Consumed when skills 4 and 5 of the paladin class are used.
Duration: 100.0s
[/left]

[b][color=sky_blue]- Borrowed Time -[/color]
[i]Passive Tick Type[/i][/b]
[left]Action: Saves the amount of health when this buff is activated. Rapidly heals back health when below the saved amount, but all the healed health will be dealt back as damage when this ends. Damage is reduced by the amount of retribution stacks that you have.
Duration: NA"
scroll_active = false
horizontal_alignment = 1

