script/source = "extends CPUParticles2D

var life_time = 180

func _ready() -> void:
	emitting = true

func set_pos(val):
	position = val

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	life_time -= 1
	
	if life_time == 0:
		queue_free()
"

